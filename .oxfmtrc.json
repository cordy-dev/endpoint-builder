{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "tests/fixtures/**",
    "bun.lock",
    "llms-full.txt",
    "**/*.md",
    "tests/generated/**"
  ]
}
